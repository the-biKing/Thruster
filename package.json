{
  "name": "thruster",
  "displayName": "Thruster",
  "description": "Agent-driven MCU development platform for ESP32, Arduino, RP2040, and STM32. Features preprocessor-guarded unit testing via Serial, MCP Server, and one-click compile and flash.",
  "version": "1.0.0",
  "publisher": "the-biKing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-biKing/Thruster.git"
  },
  "bugs": {
    "url": "https://github.com/the-biKing/Thruster/issues"
  },
  "homepage": "https://github.com/the-biKing/Thruster#readme",
  "icon": "Thruster.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "thruster",
    "agentic",
    "mcp",
    "tdd",
    "testing",
    "esp32",
    "nodemcu",
    "arduino",
    "flash",
    "serial",
    "antigravity",
    "mcu",
    "rp2040",
    "uno"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:arduino",
    "workspaceContains:**/*.ino",
    "onCommand:thruster.init",
    "onCommand:thruster.setupAgenticDev",
    "onCommand:thruster.flash",
    "onCommand:thruster.flashAndMonitor",
    "onCommand:thruster.compile",
    "onCommand:thruster.monitor",
    "onCommand:thruster.selectPort",
    "onCommand:thruster.selectBoard",
    "onCommand:thruster.installLibraries",
    "onCommand:thruster.setupCli",
    "onCommand:thruster.openSettings",
    "onCommand:thruster.stopMonitor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "thruster.init",
        "title": "Thruster: Initialize Project",
        "icon": "$(rocket)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.setupAgenticDev",
        "title": "Thruster: Setup Agentic MCU Development (Skills & MCP)",
        "icon": "$(sparkle)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.flash",
        "title": "Thruster: Flash (Upload)",
        "icon": "$(zap)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.flashAndMonitor",
        "title": "Thruster: Flash & Monitor",
        "icon": "$(run-all)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.compile",
        "title": "Thruster: Compile / Verify",
        "icon": "$(check)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.monitor",
        "title": "Thruster: Serial Monitor",
        "icon": "$(radio-tower)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.stopMonitor",
        "title": "Thruster: Stop Serial Monitor",
        "icon": "$(debug-stop)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.selectPort",
        "title": "Thruster: Select COM Port",
        "icon": "$(plug)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.selectBoard",
        "title": "Thruster: Select Board",
        "icon": "$(circuit-board)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.installLibraries",
        "title": "Thruster: Scan & Install Missing Libraries",
        "icon": "$(cloud-download)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.setupCli",
        "title": "Thruster: Setup / Locate arduino-cli",
        "icon": "$(tools)",
        "enablement": "!thruster.isBusy"
      },
      {
        "command": "thruster.openSettings",
        "title": "Thruster: Open Settings & Readiness Checklist",
        "icon": "$(gear)",
        "enablement": "!thruster.isBusy"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "thruster.init",
          "when": "resourceExtname == .ino && !thruster.isInitialized",
          "group": "navigation@1.1"
        },
        {
          "command": "thruster.compile",
          "when": "resourceExtname == .ino && thruster.isInitialized",
          "group": "navigation@1.1"
        },
        {
          "command": "thruster.flash",
          "when": "resourceExtname == .ino && thruster.isInitialized",
          "group": "navigation@1.2"
        },
        {
          "command": "thruster.flashAndMonitor",
          "when": "resourceExtname == .ino && thruster.isInitialized",
          "group": "navigation@1.3"
        },
        {
          "command": "thruster.monitor",
          "when": "resourceExtname == .ino && thruster.isInitialized && !thruster.isMonitoring",
          "group": "navigation@1.4"
        },
        {
          "command": "thruster.stopMonitor",
          "when": "resourceExtname == .ino && thruster.isInitialized && thruster.isMonitoring",
          "group": "navigation@1.4"
        },
        {
          "command": "thruster.openSettings",
          "when": "resourceExtname == .ino",
          "group": "navigation@1.5"
        }
      ]
    }
  }
}